#include <iostream>
using namespace std;
// Base class
class Employee {
protected:
    float salary;
public:
    Employee(float s) {
        salary = s;
    }
    // Virtual function
    virtual float calculateBonus() {
        return 0;
    }
    virtual ~Employee() {}   // Virtual destructor
};
// Derived class Manager
class Manager : public Employee {
public:
    Manager(float s) : Employee(s) {}
    float calculateBonus() override {
        return salary * 0.20;   // 20% bonus
    }
};
// Derived class Developer
class Developer : public Employee {
public:
    Developer(float s) : Employee(s) {}
    float calculateBonus() override {
        return salary * 0.15;   // 15% bonus
    }
};
int main() {
    Employee *emp;   // Base class pointer
    Manager m(50000);
    Developer d(40000);
    // Dynamic binding
    emp = &m;
    cout << "Manager Bonus: " << emp->calculateBonus() << endl;
    emp = &d;
    cout << "Developer Bonus: " << emp->calculateBonus() << endl;
    return 0;
}
